# MewAgent 环境变量示例
# 用法：复制为 .env（已被 .gitignore 忽略），填入真实值；不要把 .env 提交进仓库。
# 只支持 OpenAI 兼容的 /chat/completions 接口（DeepSeek、OpenAI、GLM、MiniMax、OpenRouter 等）。

# 必填：API Key
MEWCODE_API_KEY=sk-your-key-here

# 可选：OpenAI 兼容的 base URL（默认 https://api.deepseek.com）
# 客户端会在其后拼接 /chat/completions；OpenAI 等服务通常需要写成 https://api.openai.com/v1
MEWCODE_BASE_URL=https://api.deepseek.com

# 可选：模型名（缺省由代码内置默认值决定）
MEWCODE_MODEL=deepseek-flash

# 可选：覆盖 bash 路径（Windows 默认优先 Git Bash，其次 cmd.exe）
# MEWCODE_SHELL=C:\Program Files\Git\bin\bash.exe
